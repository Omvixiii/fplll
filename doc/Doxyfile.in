# Generated by Meson from doc/Doxyfile.in; local edits are overwritten.

PROJECT_NAME           = fplll
PROJECT_NUMBER         = @PROJECT_NUMBER@
PROJECT_BRIEF          = Lattice algorithms using floating-point arithmetic
OUTPUT_DIRECTORY       = @OUTPUT_DIRECTORY@
OUTPUT_LANGUAGE        = English
QUIET                  = YES
WARNINGS               = YES
INPUT                  = @SOURCE_ROOT@/fplll \
                         @SOURCE_ROOT@/README.md \
                         @SOURCE_ROOT@/CONTRIBUTING.md \
                         @SOURCE_ROOT@/CHANGELOG.md \
                         @SOURCE_ROOT@/doc/usage.md \
                         @SOURCE_ROOT@/doc/building.md
FILE_PATTERNS          = *.cpp *.h *.hpp *.inl *.md
RECURSIVE              = YES
EXCLUDE                = @SOURCE_ROOT@/fplll/io/json.hpp @BUILD_ROOT@
USE_MDFILE_AS_MAINPAGE = @SOURCE_ROOT@/README.md
INCLUDE_PATH           = @BUILD_ROOT@
INPUT_ENCODING         = UTF-8

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
BUILTIN_STL_SUPPORT    = YES
MARKDOWN_STRICT        = NO
MARKDOWN_ID_STYLE      = GITHUB
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "FPLLL_BEGIN_NAMESPACE=namespace fplll {" \
                         "FPLLL_END_NAMESPACE=}"

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_DYNAMIC_MENUS     = NO
OBFUSCATE_EMAILS       = NO
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_FORMAT         = SVG
MATHJAX_RELPATH        = https://cdn.jsdelivr.net/npm/mathjax@3.2.2

DOT_IMAGE_FORMAT       = svg
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = NO
INCLUDE_GRAPH          = NO

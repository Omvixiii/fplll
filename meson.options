option(
    'qd',
    type: 'feature',
    value: 'disabled',
    description: 'Enable quad-double arithmetic through libqd',
)

option(
    'max_enum_dim',
    type: 'integer',
    value: 256,
    min: 1,
    max: 1024,
    description: 'Maximum supported enumeration dimension',
)

option(
    'max_parallel_enum_dim',
    type: 'integer',
    value: 120,
    min: 0,
    max: 160,
    description: 'Maximum parallel enumeration dimension (0 disables it; otherwise a multiple of 10 from 20 to 160)',
)

option(
    'debug_checks',
    type: 'boolean',
    value: false,
    description: 'Compile in internal invariant checks (independent of NDEBUG)',
)

option(
    'tests',
    type: 'boolean',
    value: false,
    description: 'Build and register the test suite (needs Catch2)',
)

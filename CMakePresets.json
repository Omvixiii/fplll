{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_LIBDIR": "lib"
      }
    },
    {
      "name": "gcc-debug-no-parallel",
      "displayName": "GCC Debug (parallel enumeration disabled)",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-debug-no-parallel",
      "cacheVariables": {
        "FPLLL_MAX_PARALLEL_ENUM_DIM": "0"
      }
    },
    {
      "name": "gcc-debug-qd",
      "displayName": "GCC Debug (QD enabled)",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-debug-qd",
      "cacheVariables": {
        "FPLLL_WITH_QD": "ON"
      }
    },
    {
      "name": "gcc-debug-iterative",
      "displayName": "GCC Debug (recursive enumeration disabled)",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-debug-iterative",
      "cacheVariables": {
        "FPLLL_WITH_RECURSIVE_ENUM": "OFF"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/_install/cmake-release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "jobs": 4
    },
    {
      "name": "gcc-debug-no-parallel",
      "configurePreset": "gcc-debug-no-parallel",
      "jobs": 4
    },
    {
      "name": "gcc-debug-qd",
      "configurePreset": "gcc-debug-qd",
      "jobs": 4
    },
    {
      "name": "gcc-debug-iterative",
      "configurePreset": "gcc-debug-iterative",
      "jobs": 4
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "jobs": 4
    }
  ]
}

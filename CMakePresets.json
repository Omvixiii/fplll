{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/_install/${presetName}",
        "FPLLL_MAX_PARALLEL_ENUM_DIM": "20"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "11",
        "FPLLL_MAX_PARALLEL_ENUM_DIM": "120"
      }
    },
    {
      "name": "gcc-asan",
      "displayName": "GCC AddressSanitizer",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "FPLLL_MAX_PARALLEL_ENUM_DIM": "0",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "gcc-ubsan",
      "displayName": "GCC UndefinedBehaviorSanitizer",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "FPLLL_MAX_PARALLEL_ENUM_DIM": "0",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "gcc-coverage",
      "displayName": "GCC Coverage",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "common-build",
      "hidden": true,
      "jobs": 8
    },
    {
      "name": "gcc-debug",
      "inherits": "common-build",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "inherits": "common-build",
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-asan",
      "inherits": "common-build",
      "configurePreset": "gcc-asan"
    },
    {
      "name": "gcc-ubsan",
      "inherits": "common-build",
      "configurePreset": "gcc-ubsan"
    },
    {
      "name": "gcc-coverage",
      "inherits": "common-build",
      "configurePreset": "gcc-coverage"
    }
  ],
  "testPresets": [
    {
      "name": "common-test",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "gcc-debug",
      "inherits": "common-test",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "inherits": "common-test",
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-asan",
      "inherits": "common-test",
      "configurePreset": "gcc-asan"
    },
    {
      "name": "gcc-ubsan",
      "inherits": "common-test",
      "configurePreset": "gcc-ubsan"
    },
    {
      "name": "gcc-coverage",
      "inherits": "common-test",
      "configurePreset": "gcc-coverage"
    }
  ]
}

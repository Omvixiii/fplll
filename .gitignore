# Build and install trees
/build/
/build-*/

# Stray compilation database (Meson writes it inside the build directory)
/compile_commands.json

# Meson subprojects: only the pinned wrap files are tracked, checkouts and
# downloaded archives are local state.
/subprojects/*
!/subprojects/*.wrap

# Local working notes and editor configuration
/notes/
/.agents/
.DS_Store
*.dSYM/
.vscode/
.idea/
.fleet/
*.swp
*.swo
*~
*.log

# clangd index cache, created at the source root
/.cache/

# Build, install and local cache trees
/build/
/_install/
/.cache/

# Local working notes and editor configuration, except shared language mappings
/notes/
/.vscode/*
!/.vscode/settings.json
/CMakeUserPresets.json
/compile_commands.json
.venv

# CMake may create these before rejecting an in-source configure.
/CMakeCache.txt
/CMakeFiles/

# Generated API documentation and editor indexes
/doc/html/
/GPATH
/GRTAGS
/GSYMS
/GTAGS
TAGS
**/*.DS_Store

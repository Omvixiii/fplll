#ifndef FPLLL_CONFIG__H
#define FPLLL_CONFIG__H

/* use quaddouble library */
/* #undef FPLLL_WITH_QD */

/* fplll major version */
#define FPLLL_MAJOR_VERSION @PROJECT_VERSION_MAJOR@

/* fplll minor version */
#define FPLLL_MINOR_VERSION @PROJECT_VERSION_MINOR@

/* fplll micro version */
#define FPLLL_MICRO_VERSION @PROJECT_VERSION_PATCH@

/* fplll version */
#define FPLLL_VERSION "@PROJECT_VERSION@"

/* fplll version info */
#define FPLLL_VERSION_INFO "@PROJECT_VERSION@"

/* Maximum supported enumeration dimension */
#define FPLLL_MAX_ENUM_DIM 256

/* Recursive enumeration enabled */
#define FPLLL_WITH_RECURSIVE_ENUM 1

/* Maximum supported parallel enumeration dimension */
#define FPLLL_MAX_PARALLEL_ENUM_DIM 120

/* Switch between GMP and MPIR */
#define HAVE_LIBGMP 1
/* #undef HAVE_LIBMPIR */
#define HAVE_LIBMPFR 1

/* external enumeration */
/* #undef FPLLL_EXTENUM_FUNC */

#endif /* FPLLL_CONFIG__H */

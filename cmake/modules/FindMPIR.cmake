find_path(MPIR_INCLUDE_DIR NAMES mpir.h
  HINTS "${FPLLL_MPIR_ROOT}" PATH_SUFFIXES include)
find_library(MPIR_LIBRARY NAMES mpir
  HINTS "${FPLLL_MPIR_ROOT}" PATH_SUFFIXES lib lib64)
find_path(MPIR_GMP_INCLUDE_DIR NAMES gmp.h
  HINTS "${FPLLL_MPIR_ROOT}" "${MPIR_INCLUDE_DIR}" PATH_SUFFIXES include)

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(MPIR
  REQUIRED_VARS MPIR_LIBRARY MPIR_INCLUDE_DIR MPIR_GMP_INCLUDE_DIR)

if(MPIR_FOUND AND NOT TARGET MPIR::MPIR)
  add_library(MPIR::MPIR UNKNOWN IMPORTED)
  set_target_properties(MPIR::MPIR PROPERTIES
    IMPORTED_LOCATION "${MPIR_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${MPIR_INCLUDE_DIR};${MPIR_GMP_INCLUDE_DIR}")
endif()
mark_as_advanced(MPIR_INCLUDE_DIR MPIR_LIBRARY MPIR_GMP_INCLUDE_DIR)

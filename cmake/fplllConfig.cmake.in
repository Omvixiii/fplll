@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Keep the module search path local even when find_dependency() returns early.
function(_fplll_find_dependency dependency)
  set(fplll_FOUND FALSE PARENT_SCOPE)
  set(fplll_NOT_FOUND_MESSAGE "fplll requires ${dependency}" PARENT_SCOPE)
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/modules")
  if(dependency STREQUAL "FplllExtEnum")
    set(FplllExtEnum_NAME "@FPLLL_EXTENUM_PACKAGE_NAME@")
  endif()
  find_dependency(${dependency})
  set(fplll_FOUND TRUE PARENT_SCOPE)
  unset(fplll_NOT_FOUND_MESSAGE PARENT_SCOPE)
endfunction()

set(fplll_FOUND TRUE)
set(_fplll_dependencies "@FPLLL_PACKAGE_DEPENDENCIES@")
foreach(_fplll_dependency IN LISTS _fplll_dependencies)
  if(_fplll_dependency STREQUAL "FplllExtEnum")
    set(_fplll_target FPLLL::ExtEnum)
  else()
    set(_fplll_target "${_fplll_dependency}::${_fplll_dependency}")
  endif()
  if(NOT TARGET "${_fplll_target}")
    _fplll_find_dependency(${_fplll_dependency})
    if(NOT fplll_FOUND)
      return()
    endif()
  endif()
endforeach()
unset(_fplll_dependencies)
unset(_fplll_dependency)
unset(_fplll_target)

include("${CMAKE_CURRENT_LIST_DIR}/fplllTargets.cmake")
check_required_components(fplll)

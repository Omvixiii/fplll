@INCLUDE = "@CMAKE_CURRENT_SOURCE_DIR@/Doxyfile"
PROJECT_NUMBER = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/doc"
INPUT = "@CMAKE_CURRENT_SOURCE_DIR@/fplll" \
        "@CMAKE_CURRENT_SOURCE_DIR@/README.md" \
        "@CMAKE_CURRENT_SOURCE_DIR@/doc/usage.md" \
        "@CMAKE_CURRENT_SOURCE_DIR@/doc/building.md"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/README.md"
EXCLUDE += "@CMAKE_CURRENT_BINARY_DIR@"

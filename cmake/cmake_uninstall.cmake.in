cmake_minimum_required(VERSION 3.25)

if(NOT EXISTS "@FPLLL_INSTALL_MANIFEST@")
  message(FATAL_ERROR
    "Cannot find install manifest '@FPLLL_INSTALL_MANIFEST@'. "
    "Install from this build directory before requesting uninstall.")
endif()

file(STRINGS "@FPLLL_INSTALL_MANIFEST@" installed_files)
foreach(installed_file IN LISTS installed_files)
  set(staged_file "$ENV{DESTDIR}${installed_file}")
  if(EXISTS "${staged_file}" OR IS_SYMLINK "${staged_file}")
    file(REMOVE "${staged_file}")
  endif()
endforeach()

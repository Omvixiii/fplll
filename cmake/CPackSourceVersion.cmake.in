# Binary packages already contain the configured headers and package metadata.
if(CPACK_INSTALL_CMAKE_PROJECTS)
  return()
endif()

file(WRITE "${CPACK_TEMPORARY_DIRECTORY}/cmake/FplllArchiveVersion.cmake"
  "# Generated by CPack; do not edit.\n"
  "set(FPLLL_ARCHIVE_VERSION \"@PROJECT_VERSION@\")\n"
  "set(FPLLL_ARCHIVE_VERSION_INFO \"@FPLLL_VERSION_INFO@\")\n")
